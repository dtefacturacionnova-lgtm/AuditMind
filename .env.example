# ─── SUPABASE ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ─── NEXT.JS FRONTEND (variables públicas) ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_PORTAL_URL=http://localhost:3002
NEXT_PUBLIC_APP_ENV=development

# ─── IA / LLM ─────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...             # OpenRouter — proveedor PRIMARIO de todos los asistentes (con saldo); vacío = se usa Gemini
# OPENROUTER_MODEL_SIMPLE=openai/gpt-6-luna      # opcional: modelo por complejidad (ai-service); por defecto el mismo barato en los 3 (benchmark 2026-11-21)
# OPENROUTER_MODEL_STANDARD=openai/gpt-6-luna    # opcional: también lo usa el API para sus asistentes de papeles
# OPENROUTER_MODEL_COMPLEX=openai/gpt-6-luna     # opcional: solo CICERO, CASSANDRA, SENADO y SHERLOCK; subirlo si hiciera falta (p. ej. openai/gpt-5-mini)
# OPENROUTER_REASONING_EFFORT=low                # opcional: low | medium | high | off
# OPENROUTER_DATA_COLLECTION=deny                # opcional: deny (por defecto) = solo proveedores que no guardan ni entrenan con los datos; allow = sin preferencia
ANTHROPIC_API_KEY=sk-ant-api03-...          # Claude directo — último recurso (opcional; vacío = se salta)
GEMINI_API_KEY=AIzaSy...                    # Gemini — respaldo (capa gratuita: se agota con 429) y embeddings/OCR
OPENAI_API_KEY=sk-...                       # OpenAI — embeddings text-embedding-3-small (opcional)

# ─── REDIS (Upstash) ──────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...
REDIS_URL=redis://localhost:6379  # Para desarrollo local con Docker

# ─── MEILISEARCH ──────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev_master_key_local

# ─── EMAIL (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@auditmind.app
EMAIL_FROM_NAME="Nova Criterio"

# ─── NOTIFICACIONES (Novu) ────────────────────────────────────────────────────
NOVU_API_KEY=...
NOVU_APP_ID=...

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
AWS_S3_BUCKET=auditmind-files
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# ─── SEGURIDAD ────────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
ENCRYPTION_KEY=32-char-encryption-key-for-tokens
PORTAL_TOKEN_SECRET=portal-token-secret-change-in-prod

# ─── SERVICIOS ────────────────────────────────────────────────────────────────
PORT_API=3001
PORT_AI_SERVICE=8000
NODE_ENV=development
