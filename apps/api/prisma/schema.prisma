// ─── MÓDULO 13: QAIP ──────────────────────────────────────────────────────────
// Dos tracks normativos paralelos sobre la misma maquinaria (ver
// C:\Users\DELL\AppData\Local\Temp\claude\...\scratchpad\qaip_design.html,
// artefacto publicado con la investigación): IIA_INTERNAL para departamentos
// de Auditoría Interna (Normas Globales IIA 2024, Dominio V — Std. 8.3/8.4/
// 12.1/12.2/12.3) y NIGC_EXTERNAL para despachos que auditan EEFF/Fiscal/AML
// (NIGC 1/2 = ISQM 1/2, obligatorias CVPCPA desde encargos posteriores a
// dic-2022). Un mismo despacho puede tener ambos tracks activos a la vez.

model QaipStandard {
  id        String    @id @default(cuid())
  track     QaipTrack
  code      String // "Std. 12.1", "NIGC1-C4"
  component String // dominio/componente al que pertenece, para agrupar en la UI
  title     String
  guidance  String? // qué evidencia se espera para calificar este standard
  sortOrder Int       @default(0)
  active    Boolean   @default(true)

  items QaipAssessmentItem[]

  @@unique([track, code])
  @@index([track])
  @@map("qaip_standards")
}

// Evaluación de calidad de un track completo en un período — una autoevaluación
// anual (Std. 12.1 / NIGC 1) o una evaluación externa (EQA/SAIV, Std. 8.4).
// Mismo patrón que AcceptanceCheck: `decidedAt` nulo = en curso, no un campo
// de status aparte.
model QaipAssessment {
  id                   String             @id @default(cuid())
  organizationId       String
  track                QaipTrack
  kind                 QaipAssessmentKind @default(AUTOEVALUACION)
  period               String // "2026"
  assessorName         String? // solo EQA_EXTERNA/SAIV — evaluador independiente
  overallResult        AcceptanceRating   @default(PENDING)
  overallJustification String?
  nextDueAt            DateTime? // próxima EQA (Std. 8.4: cada 5 años)
  decidedById          String?
  decidedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decidedBy    User?                @relation(fields: [decidedById], references: [id])
  items        QaipAssessmentItem[]

  @@unique([organizationId, track, period])
  @@index([organizationId])
  @@map("qaip_assessments")
}

// Una fila por standard calificado dentro de una QaipAssessment.
model QaipAssessmentItem {
  id           String           @id @default(cuid())
  assessmentId String
  standardId   String
  rating       AcceptanceRating @default(PENDING)
  evidence     String?
  notes        String?

  assessment QaipAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  standard   QaipStandard   @relation(fields: [standardId], references: [id])
  findings   QaipFinding[]

  @@unique([assessmentId, standardId])
  @@map("qaip_assessment_items")
}

// ─── QAIP V2 — Hallazgos, causa raíz y remediación ─────────────────────────
// NIGC 1 componente 8 exige análisis de causa raíz OBLIGATORIO para toda
// deficiencia — no es una mejor práctica, es texto de la norma. Un hallazgo
// puede originarse en una autoevaluación (assessmentItemId), en una EQR
// futura (engagementId — sin @relation todavía: EQR llega en V3, cuando
// exista el modelo EngagementQualityReview que realmente lo produzca), en
// el Comité, o ad-hoc.
enum QaipFindingSource {
  AUTOEVALUACION
  EQR
  COMITE
  AD_HOC
}

enum QaipFindingStatus {
  OPEN
  REMEDIATED
  CLOSED
}

model QaipFinding {
  id               String            @id @default(cuid())
  organizationId   String
  track            QaipTrack
  source           QaipFindingSource
  assessmentItemId String?
  engagementId     String? // sin @relation a propósito — ver comentario arriba
  severity         FindingSeverity
  description      String
  status           QaipFindingStatus @default(OPEN)
  createdById      String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assessmentItem      QaipAssessmentItem?     @relation(fields: [assessmentItemId], references: [id])
  createdBy           User                     @relation(fields: [createdById], references: [id])
  rootCauses           QaipRootCause[]
  remediationActions   QaipRemediationAction[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("qaip_findings")
}

enum QaipRootCauseCategory {
  COMPETENCIA
  PRESION_TIEMPO
  BRECHA_METODOLOGICA
  SUPERVISION_INSUFICIENTE
  TONO_DIRECCION
  OTRO
}

// Por qué ocurrió, no solo qué ocurrió — 1:N con QaipFinding porque una
// deficiencia puede tener más de una causa concurrente.
model QaipRootCause {
  id        String                 @id @default(cuid())
  findingId String
  category  QaipRootCauseCategory
  analysis  String
  createdAt DateTime               @default(now())

  finding QaipFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("qaip_root_causes")
}

// Sin valor OVERDUE persistido a propósito: "vencido" se calcula en consulta
// (status=OPEN AND dueDate < hoy) — mismo patrón que FindingAction, que
// tampoco persiste ese estado.
enum QaipRemediationStatus {
  OPEN
  DONE
}

model QaipRemediationAction {
  id              String                @id @default(cuid())
  findingId       String
  description     String
  ownerId         String
  dueDate         DateTime
  status          QaipRemediationStatus @default(OPEN)
  closureEvidence String?
  closedAt        DateTime?
  createdAt       DateTime              @default(now())

  finding QaipFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  owner   User        @relation(fields: [ownerId], references: [id])

  @@index([findingId])
  @@map("qaip_remediation_actions")
}

model IndependenceDeclaration {
  id              String   @id @default(cuid())
  organizationId  String
  caeId           String
  year            Int
  declarationText String
  signedAt        DateTime
  documentUrl     String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("independence_declarations")
}

model AuditCharter {
  id             String   @id @default(cuid())
  organizationId String
  version        Int
  content        Json
  approvedBy     String
  approvedAt     DateTime
  effectiveDate  DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("audit_charters")
}

// ─── MÓDULO 14: COMITÉ DE AUDITORÍA ───────────────────────────────────────────

model CommitteeSession {
  id              String    @id @default(cuid())
  organizationId  String
  sessionDate     DateTime
  agenda          Json      @default("[]")
  minutes         Json?
  attendees       Json      @default("[]")
  status          String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  nextSessionDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id])
  reports      CommitteeReport[]

  @@index([organizationId])
  @@map("committee_sessions")
}

model CommitteeReport {
  id             String    @id @default(cuid())
  organizationId String
  sessionId      String?
  period         String
  type           String // QUARTERLY | ANNUAL | SPECIAL
  content        Json
  preparedById   String
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id])
  session      CommitteeSession? @relation(fields: [sessionId], references: [id])

  @@unique([organizationId, period, type])
  @@index([organizationId])
  @@map("committee_reports")
}

// ─── MÓDULO 15: BCP/DRP ───────────────────────────────────────────────────────

model BcpAudit {
  id               String    @id @default(cuid())
  auditId          String    @unique
  organizationId   String
  framework        String    @default("ISO_22301")
  bcpMaturityScore Int? // 1-5
  components       Json      @default("{}")
  rtoRpoAssessment Json?
  lastTestedAt     DateTime?
  recommendations  Json      @default("[]")
  createdAt        DateTime  @default(now())

  audit Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("bcp_audits")
}

// ─── NOTIFICACIONES ───────────────────────────────────────────────────────────

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String
  entityType     String?
  entityId       String?
  read           Boolean             @default(false)
  readAt         DateTime?
  channel        NotificationChannel @default(IN_APP)
  createdAt      DateTime            @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([organizationId])
  @@map("notifications")
}

// ─── MÓDULO 16: CONECTORES DE DATOS (2.6-2.8) ─────────────────────────────────

model DataSource {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  type           DataSourceType
  status         ConnectorStatus @default(INACTIVE)
  // Connection config (credenciales almacenadas como JSON — encriptar en prod)
  config         Json            @default("{}")
  // Metadata para test de conectividad
  lastTestedAt   DateTime?
  lastTestStatus String? // "ok" | "error"
  lastTestError  String?
  // Estadísticas de importaciones
  lastImportAt   DateTime?
  totalImports   Int             @default(0)
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation(fields: [createdById], references: [id])
  imports      ConnectorImport[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@map("data_sources")
}

model ConnectorImport {
  id          String       @id @default(cuid())
  sourceId    String
  auditId     String?
  status      ImportStatus @default(PENDING)
  // Resultados
  recordCount Int?
  errorMsg    String?
  result      Json? // resumen de datos importados
  // Tiempos
  startedAt   DateTime     @default(now())
  completedAt DateTime?

  source DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  audit  Audit?     @relation(fields: [auditId], references: [id])

  @@index([sourceId])
  @@index([auditId])
  @@map("connector_imports")
}

// ══════════════════════════════════════════════════════════════════════════════
//  LISTAS DE SANCIONES — Motor CAATs #18: Screening OFAC/ONU
//  Recurso de PLATAFORMA (sin organizationId) — todas las organizaciones
//  comparten la misma copia local de OFAC SDN + Lista Consolidada ONU. El
//  motor CAATs (apps/ai-service/app/services/caats/sanctions_screening.py)
//  lee esta tabla directamente vía asyncpg (única excepción documentada al
//  patrón "NestJS orquesta, ai-service es tonto" — ver justificación en el
//  plan de diseño). NUNCA se borra una entrada dada de baja: se marca
//  active=false, porque un nombre que SÍ estuvo sancionado en el pasado es
//  evidencia de auditoría relevante para hallazgos de períodos anteriores.
// ══════════════════════════════════════════════════════════════════════════════

enum WatchlistSourceList {
  OFAC_SDN
  UN_CONSOLIDATED
  UK_SANCTIONS // "UK Sanctions List" (FCDO) — reemplazó a la antigua OFSI Consolidated List, retirada 28/01/2026
}

enum WatchlistEntityType {
  INDIVIDUAL
  ENTITY
  OTHER
}

enum WatchlistSyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model WatchlistEntry {
  id              String              @id @default(cuid())
  sourceList      WatchlistSourceList
  externalId      String // uid (OFAC) / n° de referencia (ONU)
  entityType      WatchlistEntityType @default(OTHER)
  primaryName     String
  aliases         String[]            @default([])
  programs        String[]            @default([])
  nationality     String[]            @default([])
  countries       String[]            @default([])
  dateOfBirth     String? // texto libre — las fuentes dan fechas parciales/aproximadas, no cabe en DateTime
  placeOfBirth    String?
  remarks         String?
  rawRecord       Json // registro original del parser — trazabilidad
  active          Boolean             @default(true) // false = dado de baja (delisting) — nunca se borra
  sourceUpdatedAt DateTime?
  lastSyncId      String? // último WatchlistSync que confirmó/tocó este registro
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([sourceList, externalId])
  @@index([sourceList, active])
  @@map("watchlist_entries")
}

// Molde: ConnectorImport (PENDING→RUNNING→COMPLETED/FAILED). Una fila POR
// LISTA por corrida — OFAC y ONU publican en calendarios distintos y pueden
// fallar independientemente.
model WatchlistSync {
  id                 String              @id @default(cuid())
  sourceList         WatchlistSourceList
  status             WatchlistSyncStatus @default(PENDING)
  triggeredBy        String // "CRON" | "MANUAL"
  triggeredById      String?
  recordsFetched     Int?
  recordsUpserted    Int?
  recordsDeactivated Int?
  errorMsg           String?
  startedAt          DateTime            @default(now())
  completedAt        DateTime?

  triggeredByUser User? @relation(fields: [triggeredById], references: [id])

  @@index([sourceList, startedAt])
  @@map("watchlist_syncs")
}

// ══════════════════════════════════════════════════════════════════════════════
//  INVESTIGACIÓN FORENSE — SHERLOCK (Fase 2b, núcleo mínimo)
//  docs/investigador-forense-multimodal-propuesta.md — informe generado en un
//  solo paso (molde: ConnectorImport/ImportStatus) a partir del Grafo de
//  Evidencia (GraphEntity/GraphRelation, Fase 1) más el contexto previo del
//  auditor (FieldEvidence.proposito = CONTEXTO_INVESTIGADOR).
// ══════════════════════════════════════════════════════════════════════════════

enum InvestigationReportStatus {
  PENDING // declarado por paridad con ImportStatus — el flujo real crea directo en RUNNING
  RUNNING
  COMPLETED
  FAILED
}

model InvestigationReport {
  id            String                    @id @default(cuid())
  auditId       String
  objetivo      String // objetivo del análisis — texto libre del auditor
  status        InvestigationReportStatus @default(PENDING)
  result        Json? // InvestigationReportResult — ver investigation-report.service.ts
  errorMsg      String?
  requestedById String
  startedAt     DateTime                  @default(now())
  completedAt   DateTime?

  audit       Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requestedBy User  @relation(fields: [requestedById], references: [id])

  @@index([auditId])
  @@map("investigation_reports")
}

// Fase 2c: auto-detección + auto-ejecución de un motor CAATs a partir de una
// hoja de cálculo subida en el tab Investigador (molde: ConnectorImport,
// mismo criterio que InvestigationReport arriba) — NO usa DataSource/
// ConnectorImport reales porque esos representan conexiones externas
// recurrentes (bancos, ERPs), no un archivo suelto de una sola vez. El motor
// se sigue ejecutando desde el frontend llamando POST /ai/analytics/:engine
// directo (igual que el panel CAATs manual) — este modelo solo persiste el
// resultado ya calculado, no reejecuta nada server-side.
model CaatsAutoRun {
  id                     String   @id @default(cuid())
  auditId                String
  engine                 String // uno de los 15 AnalysisId auto-ejecutables — sin enum Prisma, igual que el `type` de POST /ai/analytics/:type
  fileName               String?
  descripcion            String // texto libre del auditor sobre qué es el archivo — insumo de la clasificación
  fieldMapping           Json? // {fieldMapping?, benfordColumn?, anomalyColumns?} — mismo shape libre que ya usa CaatsAnalysisValue
  result                 Json // resultado crudo del motor — se pasa tal cual a <AnalysisResultView>
  confianzaDeteccion     Float?
  justificacionDeteccion String?
  requestedById          String
  ranAt                  DateTime @default(now())

  audit       Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  requestedBy User  @relation(fields: [requestedById], references: [id])

  @@index([auditId])
  @@index([auditId, engine])
  @@map("caats_auto_runs")
}

// ══════════════════════════════════════════════════════════════════════════════
//  PT-PROG: PROGRAMA DE AUDITORÍA — Grid de Procedimientos (NIA 230/330)
//  AuditProcedure (nivel 1) → AuditStep (nivel 2) → StepEvidence (adjuntos)
// ══════════════════════════════════════════════════════════════════════════════

enum ProcStatus {
  PENDING // Sin comenzar
  IN_PROGRESS // Al menos un paso iniciado
  COMPLETED // Todos los pasos aprobados
  NA // No aplicable
}

enum StepStatus {
  DRAFT // Borrador — no enviado a revisión
  IN_PROGRESS // En ejecución
  SUBMITTED // Enviado a primera revisión
  REVIEWED // Revisado (puede tener notas)
  CLEARED // Notas del revisor limpiadas
  APPROVED // Socio/CAE aprobado
}

enum StepConclusion {
  PENDING // Sin conclusión aún
  NO_EXCEPTION // Sin excepción — objetivo cumplido
  EXCEPTION // Con excepción — ver exceptionText/exceptionAmount
  NA // No aplicable
}

enum TestType {
  DETAIL // Prueba de detalle (inspección, confirmación, recálculo)
  ANALYTICAL // Procedimiento analítico sustantivo (NIA 520)
  CONTROL // Prueba de controles (NIA 330 §8)
}

enum AuditNature {
  INSPECTION // Inspección de documentos y registros
  OBSERVATION // Observación de un proceso
  INQUIRY // Indagación a la gerencia
  CONFIRMATION // Confirmación externa (NIA 505)
  RECALCULATION // Recálculo de cómputos
  REPERFORMANCE // Rejecución de procedimientos del cliente
  ANALYTICAL // Procedimientos analíticos
}

enum AuditTiming {
  INTERIM // Interino (antes del cierre)
  YEAR_END // Al cierre del período
  ROLLFORWARD // Puente interino → cierre
}

// Nivel 1 — Procedimiento de auditoría por área/aserción
model AuditProcedure {
  id              String     @id @default(cuid())
  sectionId       String // FK → PaperSection (PROCEDURE_GRID)
  refNumber       String // "B-AR-01", "PROC-01"
  description     String
  assertions      String[] // ["EXI","VAL","COM","OCC","COM","EXA","COR","CLA","PRE"]
  significantRisk Boolean    @default(false) // ISA 330 §18 — flag binario
  rmmLevel        String? // "BAJO" | "MODERADO" | "ALTO" | "MUY_ALTO"
  rmmRiskRef      String[]   @default([]) // Refs a filas de riesgo (ej. PT-A2::S5::2) — puede haber varios (ISA 330 §28c)
  wpRef           String? // Referencia cruzada al papel de trabajo donde se ejecuta/documenta este procedimiento
  conclusionText  String?
  status          ProcStatus @default(PENDING)
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  section PaperSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  steps   AuditStep[]

  @@index([sectionId])
  @@index([sectionId, status])
  @@map("audit_procedures")
}

// Nivel 2 — Actividad/Paso dentro de un procedimiento
model AuditStep {
  id                String         @id @default(cuid())
  procedureId       String // FK → AuditProcedure
  refNumber         String // "B-AR-01-A"
  description       String
  assertions        String[] // puede diferir del padre
  testType          TestType       @default(DETAIL)
  nature            AuditNature    @default(INSPECTION)
  timing            AuditTiming    @default(YEAR_END)
  extent            String? // "45 ítems MUS", "100% de saldo"
  population        String? // fuente de datos / universo
  performedByName   String? // ISA 230 §9
  performedByInitials String? // snapshot al momento de "Asignarme" — no se resuelve por lookup
  performedById     String?
  datePerformed     DateTime? // ISA 230 §9 — debe ser ≤ fecha informe
  reviewedByName    String?
  reviewedByInitials String?
  reviewedById      String?
  dateReviewed      DateTime?
  wpRef             String? // "AR-03-01" — referencia al papel de evidencia
  resultDescription String? // ISA 330 §28(d)
  conclusion        StepConclusion @default(PENDING)
  exceptionText     String? // condicional: descripción de la excepción
  exceptionAmount   Decimal?       @db.Decimal(15, 2) // monto observado
  difRef            String? // referencia a PT-DIFS si hay excepción
  hoursPlanned      Float?
  hoursActual       Float?
  status            StepStatus     @default(DRAFT)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  procedure AuditProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  evidences StepEvidence[]

  @@index([procedureId])
  @@index([procedureId, status])
  @@map("audit_steps")
}

// Adjuntos por actividad (cédulas B-01, confirmaciones, etc.)
model StepEvidence {
  id             String   @id @default(cuid())
  stepId         String // FK → AuditStep
  fileName       String
  storageKey     String // Supabase Storage key
  wpRef          String? // "AR-03-01"
  mimeType       String
  size           Int      @default(0) // bytes
  uploadedByName String?
  uploadedById   String?
  uploadedAt     DateTime @default(now())

  step AuditStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("step_evidences")
}

// ═══════════════════════════════════════════════════════════════════════════
// Tareas Administrativas — sin encargo ni auditoría (brecha vs. AuditBrain)
// ═══════════════════════════════════════════════════════════════════════════

enum AdminTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// Tablero de tareas administrativas generales de la firma (capacitación,
// gestión interna, seguimiento comercial no ligado a un cliente, etc.) —
// deliberadamente sin FK a Audit/Engagement: es el espacio para trabajo real
// del equipo que no cuelga de ningún encargo. Complementa (no reemplaza) la
// categoría TimeEntryCategory.ADMIN, que registra HORAS; este modelo registra
// la TAREA en sí (título, responsable, fecha límite, estado).
model AdminTask {
  id             String          @id @default(cuid())
  organizationId String
  title          String
  description    String?
  status         AdminTaskStatus @default(TODO)
  assignedToId   String?
  dueDate        DateTime?
  completedAt    DateTime?
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AdminTaskAssignee", fields: [assignedToId], references: [id])
  createdBy    User         @relation("AdminTaskCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([assignedToId])
  @@map("admin_tasks")
}
