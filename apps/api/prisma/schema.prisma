// ─── MÓDULO 01: NÚCLEO MULTI-TENANT ───────────────────────────────────────────

model Organization {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  plan           String    @default("starter") // starter | professional | enterprise
  settings       Json      @default("{}")
  logoUrl        String?
  primaryColor   String?   @default("#0F2D4A")
  active         Boolean   @default(true)
  trialEndsAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  users                  User[]
  auditEntities          AuditEntity[]
  auditProcesses         AuditProcess[]
  auditableUnits         AuditableUnit[]
  auditPlans             AuditPlan[]
  audits                 Audit[]
  riskRegisters          RiskRegister[]
  timeEntries            TimeEntry[]
  pbcRequests            PbcRequest[]
  findings               Finding[]
  templates              Template[]
  knowledgeDocuments     KnowledgeDocument[]
  dataAnalysisJobs       DataAnalysisJob[]
  auditReports           AuditReport[]
  notifications          Notification[]
  complianceAssessments  ComplianceAssessment[]
  normativeExceptions    NormativeException[]
  qaipEvaluations        QaipEvaluation[]
  auditCharters          AuditCharter[]
  committeeSession       CommitteeSession[]
  committeeReports       CommitteeReport[]
  independenceDecl       IndependenceDeclaration[]
  llmRouterLogs          LLMRouterLog[]
  aiInteractions         AIInteraction[]
  dataSources            DataSource[]
  indexTemplates         IndexTemplate[]
  auditTemplates         AuditTemplate[]
  contentLibraryItems    ContentLibraryItem[]
  entityTypeConfigs      EntityTypeConfig[]
  processCategoryConfigs ProcessCategoryConfig[]
  strategicObjectives    StrategicObjective[]
  strategicLines         StrategicLine[]
  auditProjects         AuditProject[]

  @@map("organizations")
}

model User {
  id                      String                 @id @default(cuid())
  organizationId          String
  supabaseUserId          String                 @unique // Supabase Auth UUID
  email                   String                 @unique
  name                    String
  role                    UserRole               @default(AUDITOR)
  avatarUrl               String?
  active                  Boolean                @default(true)
  lastLoginAt             DateTime?
  timezone                String                 @default("America/Lima")
  preferredLanguage       String                 @default("es")
  aiAssistantPersonality  AIAssistantPersonality @default(ATHENA)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  certifications    UserCertification[]
  competencies      UserCompetency[]
  cpeRecords        CpeRecord[]
  auditTeams           AuditTeam[]
  uploadedRequestDocs  AuditRequestDocument[] @relation("UploadedRequestDocs")
  workingPapers        WorkingPaper[]        @relation("PreparedBy")
  reviewedPapers       WorkingPaper[]        @relation("ReviewedBy")
  signedOffPapers       WorkingPaper[]        @relation("WpSignedOffBy")
  signedOffPhases       AuditPhase[]          @relation("PhaseSignOff")
  createdIndexTemplates IndexTemplate[]       @relation("IndexTemplateCreator")
  createdAuditTemplates AuditTemplate[]      @relation("AuditTemplateCreator")
  createdContentLibraryItems ContentLibraryItem[] @relation("ContentLibraryItemCreator")
  ownedEntities     AuditEntity[]         @relation("EntityOwner")
  findings          Finding[]             @relation("FindingResponsible")
  aiInteractions    AIInteraction[]
  notifications     Notification[]
  dataSources       DataSource[]
  auditRestoreLogs  AuditRestoreLog[]

  @@index([organizationId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model UserCertification {
  id               String            @id @default(cuid())
  userId           String
  type             CertificationType
  certNumber       String?
  issuedAt         DateTime
  expiresAt        DateTime?
  isActive         Boolean           @default(true)
  verificationUrl  String?
  createdAt        DateTime          @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_certifications")
}

model UserCompetency {
  id              String   @id @default(cuid())
  userId          String
  area            String
  expertiseLevel  Int      // 1-5
  yearsExperience Int      @default(0)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_competencies")
}

model CpeRecord {
  id          String   @id @default(cuid())
  userId      String
  year        Int
  category    String   // etica | tecnica | liderazgo
  hours       Float
  description String
  completedAt DateTime
  createdAt   DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year])
  @@map("cpe_records")
}

// ─── MÓDULO 02: UNIVERSO DE AUDITORÍA ─────────────────────────────────────────

model AuditEntity {
  id                          String   @id @default(cuid())
  organizationId              String
  name                        String
  description                 String?
  entityType                  String   @default("AREA")
  category                    String?
  parentEntityId              String?
  // Dueño del proceso (negocio)
  ownerId                     String?
  responsible                 String?
  location                    String?
  sector                      String?
  relatedSystems              Json     @default("[]")
  applicableRegulations       Json     @default("[]")
  inherentRiskScore           Int      @default(50)
  lastAuditDate               DateTime?
  recommendedFrequencyMonths  Int      @default(12)
  active                      Boolean  @default(true)
  excluded                    Boolean  @default(false)
  exclusionJustification      String?
  // Campos de documentación del área
  objective                   String?
  status                      String   @default("ACTIVE")
  employeeCount               Int?
  contactEmail                String?
  contactPhone                String?
  budget                      String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner           User?           @relation("EntityOwner", fields: [ownerId], references: [id])
  parent          AuditEntity?    @relation("EntityHierarchy", fields: [parentEntityId], references: [id])
  children        AuditEntity[]   @relation("EntityHierarchy")
  audits          Audit[]
  planItems       AuditPlanItem[]
  riskRegisters   RiskRegister[]
  auditableUnits        AuditableUnit[]
  projectsAsResponsible AuditProject[] @relation("ProjectResponsible")
  projectsAsSupport     AuditProject[] @relation("ProjectSupport")

  @@index([organizationId])
  @@index([organizationId, entityType])
  @@index([organizationId, inherentRiskScore])
  @@index([organizationId, active])
  @@map("audit_entities")
}

// ─── CATÁLOGOS GENERALES ──────────────────────────────────────────────────────

model EntityTypeConfig {
  id             String   @id @default(cuid())
  organizationId String
  value          String
  label          String
  icon           String   @default("🏢")
  color          String   @default("bg-slate-100 text-slate-700")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, value])
  @@index([organizationId])
  @@map("entity_type_configs")
}

model ProcessCategoryConfig {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  type           String   @default("OPERATING")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("process_category_configs")
}

// ─── PLAN ESTRATÉGICO ─────────────────────────────────────────────────────────
model StrategicObjective {
  id             String   @id @default(cuid())
  organizationId String
  code           String   // OE-1, OE-2…
  name           String
  description    String?
  color          String   @default("blue")  // blue|green|amber|rose|purple|teal|orange|indigo
  icon           String   @default("🎯")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines         StrategicLine[]
  auditProjects AuditProject[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("strategic_objectives")
}

model StrategicLine {
  id             String   @id @default(cuid())
  organizationId String
  objectiveId    String
  code           String   // LE-1.1, LE-1.2…
  name           String
  description    String?
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objective      StrategicObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  auditProjects  AuditProject[]
  auditableUnits AuditableUnit[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([objectiveId])
  @@map("strategic_lines")
}

// ─── BANCO DE PROYECTOS DE AUDITORÍA ─────────────────────────────────────────
model AuditProject {
  id             String   @id @default(cuid())
  organizationId String
  correlative    String   // "BAP-001"
  name           String
  planYear       Int      // año del plan (histórico o actual)

  // Tab 1 — Identificación
  strategicObjectiveId String?
  strategicLineId      String?
  responsibleEntityId  String?  // área responsable (del organigrama)
  supportEntityId      String?  // área de apoyo (del organigrama)
  riskCategory         String?  // 8 categorías predefinidas
  notes                String?

  // Tab 2 — Evaluación de Riesgo (campos unificados con AuditableUnitAssessment, escala 1-5)
  // Grupo A — Riesgo Residual (peso 30%)
  impactScore           Int?    // 1-5 Impacto si ocurre el riesgo
  likelihoodScore       Int?    // 1-5 Probabilidad de ocurrencia
  controlMaturityScore  Int?    // 1-5 Madurez de controles existentes
  // Grupo B — Factores Contextuales (peso 70%)
  materialityScore      Int?    // 1-5 Materialidad financiera (20%)
  strategicAlignScore   Int?    // 1-5 Alineación al Plan Estratégico (20%)
  operationalAlignScore Int?    // 1-5 Alineación al Plan Operativo (15%)
  fraudHistoryScore     Int?    // 1-5 Antecedentes de fraude/denuncias (15%)
  managementReqScore    Int?    // 1-5 Solicitud de la dirección (10%)
  staffTurnoverScore    Int?    // 1-5 Rotación de personal (10%)
  coverageHistoryScore  Int?    // 1-5 Historial de cobertura (10%)
  // Campos adicionales del proyecto
  legalRequirement      Int?    // 1-4 Requerimiento legal/normativo (proyecto-específico)
  lastAuditOpinion      String? // Opinión/resultado de la última auditoría heredada del Universo
  finalRiskScore        Float?  // 0–100 calculado automáticamente (misma escala que Universo)
  finalRiskLevel        String? // BAJO|MEDIO|ALTO|CRITICO
  includeInPlan     Boolean @default(false)
  targetPlanYear    Int?    // año del plan anual donde se incluirá

  // Tab 3 — Planificación de recursos
  legalBasis       String?
  frequencyPerYear Int?    @default(1)
  plannedHours     Float?
  teamJson         Json?   // [{role,count,costPerHour,hours}]
  totalBudget      Float?

  status    String   @default("DRAFT") // DRAFT|ACTIVE|ARCHIVED
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId],       references: [id], onDelete: Cascade)
  strategicObjective StrategicObjective? @relation(fields: [strategicObjectiveId], references: [id])
  strategicLine      StrategicLine?      @relation(fields: [strategicLineId],      references: [id])
  responsibleEntity  AuditEntity?        @relation("ProjectResponsible", fields: [responsibleEntityId], references: [id])
  supportEntity      AuditEntity?        @relation("ProjectSupport",      fields: [supportEntityId],      references: [id])
  planItems          AuditPlanItem[]

  @@index([organizationId])
  @@index([organizationId, planYear])
  @@map("audit_projects")
}

// ─── CATÁLOGO DE PROCESOS ─────────────────────────────────────────────────────
// Segunda dimensión del universo auditable (Organización × Proceso)
model AuditProcess {
  id             String   @id @default(cuid())
  organizationId String
  code           String   // "PROC-FIN-01"
  name           String   // "Gestión de Compras"
  description    String?
  category       String?  // Etiqueta libre del cliente
  apqcCode       String?  // Código APQC PCF: "1.0"…"13.0"
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditableUnits AuditableUnit[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("audit_processes")
}

// ─── UNIDAD AUDITABLE (EntityProcess) ────────────────────────────────────────
// Intersección AuditEntity × AuditProcess = objeto real de planificación.
// Equivale al EntityProcess de Pentana / Auditable Item de SAP.
model AuditableUnit {
  id              String   @id @default(cuid())
  organizationId  String
  auditEntityId   String
  auditProcessId  String
  name            String?  // nombre display override (si null: "Entity — Process")
  auditType       String   @default("OPERATIONAL") // FINANCIAL|OPERATIONAL|IT|COMPLIANCE|FORENSIC|ADVISORY
  isMandatory     Boolean  @default(false)  // mandato legal/regulatorio → entrada directa al plan
  mandatoryBasis  String?  // "Ley 29720 Art. 5", "Norma SBS N°2024-001", etc.
  // Clasificación estratégica y de riesgo
  strategicLineId String?  // FK opcional a línea estratégica del Plan Estratégico
  riskType        String?  // FINANCIERO|OPERACIONAL|TECNOLOGIA|CUMPLIMIENTO|FRAUDE|ESTRATEGICO|LEGAL|ESG
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEntity    AuditEntity               @relation(fields: [auditEntityId], references: [id])
  auditProcess   AuditProcess              @relation(fields: [auditProcessId], references: [id])
  strategicLine  StrategicLine?            @relation(fields: [strategicLineId], references: [id])
  assessments    AuditableUnitAssessment[]
  planItems      AuditPlanItem[]

  @@unique([organizationId, auditEntityId, auditProcessId, auditType])
  @@index([organizationId])
  @@index([auditEntityId])
  @@index([strategicLineId])
  @@index([organizationId, isMandatory])
  @@map("auditable_units")
}

// ─── EVALUACIÓN DE RIESGOS POR UNIDAD AUDITABLE ──────────────────────────────
// Motor de scoring multi-factor. Una evaluación por año por unidad.
// Score final determina candidatura al Plan Anual.
model AuditableUnitAssessment {
  id              String   @id @default(cuid())
  auditableUnitId String
  assessmentYear  Int
  assessedById    String?

  // ── Grupo A — Riesgo Residual (peso 70%) ─────────────────────────────────
  impactScore           Int   @default(3) // 1-5: magnitud del daño si ocurre el riesgo
  likelihoodScore       Int   @default(3) // 1-5: probabilidad de ocurrencia
  controlMaturityScore  Int   @default(3) // 1-5: (1=Ad-hoc, 3=Definido, 5=Optimizado)
  inherentRiskScore     Float @default(9) // calculado: impact × likelihood (1-25)
  residualRiskScore     Float @default(6) // calculado: inherent × (1 - maturity/5)

  // ── Grupo B — Factores Contextuales (peso 70%) ───────────────────────────
  materialityScore      Int @default(3) // 1-5: tamaño financiero/presupuesto del área  (20%)
  strategicAlignScore   Int @default(1) // 1-5: impacto en objetivos del Plan Estratégico (20%)
  operationalAlignScore Int @default(1) // 1-5: criticidad en el Plan Operativo          (15%)
  fraudHistoryScore     Int @default(1) // 1-5: antecedentes de fraude o denuncias       (15%)
  managementReqScore    Int @default(1) // 1-5: solicitud expresa de dirección / junta   (10%)
  changeVelocityScore   Int @default(1) // DEPRECADO — reemplazado por staffTurnoverScore
  staffTurnoverScore    Int @default(1) // 1-5: rotación de personal, nueva gerencia, M&A (10%)
  coverageHistoryScore  Int @default(1) // 1-5: historial de cobertura (frecuencia real)   (10%)

  // ── Score Ponderado Final ─────────────────────────────────────────────────
  totalScore   Float  @default(0) // calculado: (residual×0.30) + (contextuales×0.70)
  riskLevel    String @default("MEDIUM") // CRITICAL|HIGH|MEDIUM|LOW — del totalScore

  // ── Historial de cobertura ────────────────────────────────────────────────
  lastAuditDate         DateTime?
  lastAuditOpinion      String?   // SATISFACTORY|NEEDS_IMPROVEMENT|UNSATISFACTORY|CRITICAL
  recommendedFreqMonths Int       @default(12) // meses entre auditorías
  nextRecommendedDate   DateTime? // calculado: lastAuditDate + freq
  coverageGapDays       Int?      // calculado: today − nextRecommendedDate (>0 = vencido)

  notes      String?
  assessedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  auditableUnit  AuditableUnit @relation(fields: [auditableUnitId], references: [id], onDelete: Cascade)

  @@unique([auditableUnitId, assessmentYear])
  @@index([auditableUnitId])
  @@index([assessmentYear, totalScore])
  @@map("auditable_unit_assessments")
}

// ─── MÓDULO 03: PLANIFICACIÓN INTELIGENTE ─────────────────────────────────────

model AuditPlan {
  id             String   @id @default(cuid())
  organizationId String
  year           Int
  name           String
  // DRAFT | PENDING_REVIEW | APPROVED | ACTIVE | AMENDED | CLOSED
  status         String   @default("DRAFT")
  planType       String   @default("ANNUAL") // ANNUAL | ROLLING | MULTI_YEAR | INTERIM
  objectives     Json     @default("[]")
  totalHours     Float    @default(0)
  totalBudget    Float?   // presupuesto monetario (moneda local)
  // Aprobación
  approvedById   String?
  approvedAt     DateTime?
  rejectedById   String?
  rejectedAt     DateTime?
  rejectionReason String?
  // Versionado (enmiendas post-aprobación)
  version        Int      @default(1)
  amendments     Json     @default("[]") // [{date, description, approvedBy}]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items         AuditPlanItem[]

  @@unique([organizationId, year])
  @@index([organizationId])
  @@map("audit_plans")
}

model AuditPlanItem {
  id                  String   @id @default(cuid())
  planId              String
  // Referencia a entidad (legado) O a unidad auditable (nuevo)
  auditEntityId       String?
  auditableUnitId     String?  // FK a AuditableUnit (nuevo modelo)
  auditProjectId      String?  // FK a AuditProject  (P.4 — Banco de Proyectos)
  estimatedHours      Float    @default(0)
  tentativeStartDate  DateTime?
  tentativeEndDate    DateTime?
  priority            Int      @default(1) // 1=alta, 2=media, 3=baja
  // Origen del item en el plan
  isMandatory         Boolean  @default(false)  // mandato regulatorio → bypass scoring
  mandatoryReason     String?  // "Ley 29720 Art. 5"
  originScore         Float?   // totalScore en el momento de selección (trazabilidad)
  // Vínculo con la auditoría cuando se ejecuta
  auditId             String?  @unique // FK a Audit (una vez iniciada)
  notes               String?
  // L2.4 — Asignación de equipo / responsable
  responsibleName     String?  // nombre libre del auditor líder asignado
  teamNotes           String?  // notas de equipo (ej. "Senior + 2 juniors")

  plan           AuditPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  auditEntity    AuditEntity?   @relation(fields: [auditEntityId], references: [id])
  auditableUnit  AuditableUnit? @relation(fields: [auditableUnitId], references: [id])
  auditProject   AuditProject?  @relation(fields: [auditProjectId], references: [id])
  audit          Audit?         @relation("PlanItemAudit", fields: [auditId], references: [id])
  timeEntries    TimeEntry[]

  @@index([planId])
  @@index([auditableUnitId])
  @@index([auditProjectId])
  @@map("audit_plan_items")
}

// L2.8 — Registro de horas (timesheet) por auditor/auditoría
model TimeEntry {
  id              String    @id @default(cuid())
  organizationId  String
  auditId         String?
  planItemId      String?
  userId          String
  workDate        DateTime
  hours           Float
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  audit         Audit?        @relation(fields: [auditId], references: [id])
  planItem      AuditPlanItem? @relation(fields: [planItemId], references: [id])

  @@index([organizationId])
  @@index([auditId])
  @@index([planItemId])
  @@index([userId])
  @@map("time_entries")
}

// ─── MÓDULO 04: EVALUACIÓN DE RIESGOS ─────────────────────────────────────────

model RiskRegister {
  id             String   @id @default(cuid())
  organizationId String
  auditEntityId  String?
  title          String
  description    String
  category       String   // estratégico | operacional | financiero | TI | compliance | reputacional | ESG
  probability    Int      // 1-5
  impact         Int      // 1-5
  inherentScore  Int      // probability * impact
  controlsScore  Int      @default(0) // efectividad controles
  residualScore  Int      // calculado
  kris           Json     @default("[]") // Key Risk Indicators
  trend          String   @default("STABLE") // INCREASING | STABLE | DECREASING
  lastUpdated    DateTime @default(now())
  createdAt      DateTime @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEntity   AuditEntity? @relation(fields: [auditEntityId], references: [id])

  @@index([organizationId])
  @@index([organizationId, inherentScore])
  @@map("risk_registers")
}

// ─── MÓDULO 05: EJECUCIÓN DE AUDITORÍA ────────────────────────────────────────

model Audit {
  id                      String      @id @default(cuid())
  organizationId          String
  planId                  String?
  auditEntityId           String?
  title                   String
  type                    AuditType
  status                  AuditStatus @default(PLANNING)
  scope                   String?
  objectives              String?
  startDate               DateTime?
  endDate                 DateTime?
  estimatedHours          Float       @default(0)
  actualHours             Float       @default(0)
  leadAuditorId           String?

  // Sub-tipo (especialización dentro del tipo principal)
  subtype                 String?     // EEFF_COMPLETO | PROCESO | SEGURIDAD | etc.

  // ─── Planificación Anual — trazabilidad ──────────────────────────────────
  originType              AuditOriginType @default(PLANNED)
  auditPeriodStart        DateTime?   // período examinado (≠ fechas de ejecución)
  auditPeriodEnd          DateTime?
  methodology             String?     // RISK_BASED|COMPLIANCE|SUBSTANTIVE|ANALYTICAL
  reportIssuanceDate      DateTime?   // fecha emisión del informe final
  deferralReason          String?     // si status = DEFERRED
  deferredToDate          DateTime?   // nueva fecha tentativa si fue diferida

  // ─── Auditorías Imprevistas — documentación de la solicitud ──────────────
  // Aplica cuando originType = UNPLANNED_COMMITTEE | UNPLANNED_MANAGEMENT | UNPLANNED_REGULATOR
  requestedByName         String?     // Nombre del solicitante (si es externo al sistema)
  requestedByRole         String?     // Cargo / Rol del solicitante
  requestDate             DateTime?   // Fecha formal de la solicitud
  requestReason           String?     // Motivo / justificación de la solicitud
  requestAntecedents      String?     // Antecedentes relevantes (contexto previo)

  // ─── Opinión final de la auditoría ───────────────────────────────────────
  auditOpinion            AuditOpinion?   // retroalimenta universo / coverage gap

  // Modo investigación forense
  isInvestigationMode     Boolean     @default(false)
  investigationActivatedAt DateTime?
  investigationActivatedBy String?

  // Materialidad (NIA 320)
  materiality             Decimal?    @db.Decimal(15, 2)
  materialityExecution    Decimal?    @db.Decimal(15, 2) // 75% de MG
  materialityAccumulation Decimal?    @db.Decimal(15, 2) // 50% de MG
  materialityBase         String?     // PROFIT_BEFORE_TAX | TOTAL_REVENUE | etc.
  materialityBaseAmount   Decimal?    @db.Decimal(15, 2)

  // Modelo de riesgo de auditoría (NIA 200)
  auditRiskModel          Json?       // { inherentRisk, controlRisk, detectionRisk, ... }

  // PI.7d — Orquestador de pruebas IA
  lastAiTestRunAt         DateTime?
  lastAiTestSummary       Json?       // { ranAt, durationMs, tests: [{ kind, status, ... }], findingIds[], summary }

  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEntity            AuditEntity?           @relation(fields: [auditEntityId], references: [id])
  planItem               AuditPlanItem?         @relation("PlanItemAudit")
  team                   AuditTeam[]
  workingPapers          WorkingPaper[]
  timeEntries            TimeEntry[]
  pbcRequests            PbcRequest[]
  findings               Finding[]
  dataAnalysisJobs       DataAnalysisJob[]
  auditReports           AuditReport[]
  externalConfirmations  ExternalConfirmation[]
  bcpAudit               BcpAudit?
  connectorImports       ConnectorImport[]
  requestDocuments       AuditRequestDocument[]
  trialBalances          TrialBalance[]
  // ─── Expediente de auditoría (fases y carpetas) ───────────────────────────
  phases                 AuditPhase[]
  folders                AuditFolder[]

  templateId              String?
  template                AuditTemplate? @relation(fields: [templateId], references: [id])

  restoreLogs             AuditRestoreLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([leadAuditorId])
  @@map("audits")
}

// ─── BKP-12: bitácora de restauraciones destructivas ──────────────────────────
// Un registro por cada vez que se restaura un backup SOBRE un encargo
// existente (sobrescribiendo su contenido) — requisito explícito de
// `docs/backup-restauracion-encargos.md` §4: esta acción de alto riesgo debe
// "quedar registrada en el historial de auditoría del sistema". No cuelga de
// AUDIT_SCOPED_MODELS (no forma parte de lo que se respalda/restaura de un
// encargo — es metadata DEL SISTEMA sobre el encargo, no del encargo).
model AuditRestoreLog {
  id                    String   @id @default(cuid())
  auditId               String
  restoredById          String
  restoredAt            DateTime @default(now())
  backupGeneradoEn      DateTime
  backupGeneradoPor     String   // AuthUser.id de quien generó el backup (puede no existir ya)
  backupAuditTitulo     String   // título del encargo al momento del backup — informativo
  totalFilasCreadas     Int
  totalArchivosSubidos  Int
  advertencias          Json?

  audit      Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  restoredBy User  @relation(fields: [restoredById], references: [id])

  @@index([auditId])
  @@map("audit_restore_logs")
}

// ─── EXPEDIENTE: Fase del proyecto de auditoría ───────────────────────────────
// Agrupa carpetas y papeles. Actúa como "puerta de workflow":
// no se puede avanzar a Ejecución sin cerrar Planificación.
model AuditPhase {
  id            String      @id @default(cuid())
  auditId       String
  phaseType     PhaseType
  name          String      // Nombre display editable: "Planificación de la Auditoría"
  order         Int         @default(0)
  status        PhaseStatus @default(PENDING)
  signedOffById String?
  signedOffAt   DateTime?
  startDate     DateTime?
  targetDate    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  signedOffBy  User?        @relation("PhaseSignOff", fields: [signedOffById], references: [id])
  folders      AuditFolder[]

  @@unique([auditId, phaseType])
  @@index([auditId])
  @@map("audit_phases")
}

// ─── EXPEDIENTE: Carpeta / sub-carpeta (árbol libre, máx 3 niveles) ───────────
// Los usuarios crean/renombran/eliminan carpetas a su gusto.
// Al crear una auditoría desde plantilla, el sistema pre-carga la estructura.
model AuditFolder {
  id          String   @id @default(cuid())
  auditId     String
  phaseId     String?  // null = sin fase asignada (caso raro)
  parentId    String?  // null = carpeta raíz de la fase
  ref         String   // "A", "A-1", "A-1.2" — editable por usuario
  name        String   // "Planificación", "Comunicación de Auditoría"
  description String?
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  audit    Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  phase    AuditPhase?  @relation(fields: [phaseId], references: [id])
  parent   AuditFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children AuditFolder[] @relation("FolderTree")
  papers   WorkingPaper[]

  @@index([auditId])
  @@index([phaseId])
  @@index([auditId, phaseId])
  @@map("audit_folders")
}

// ─── PLANTILLAS DE ÍNDICE DEL EXPEDIENTE ─────────────────────────────────────
// Estructura de fases+carpetas pre-definida a nivel de organización.
// El usuario selecciona la plantilla al inicializar el expediente de una auditoría.
model IndexTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String   @db.VarChar(120)  // "IIA Estándar", "Auditoría TI"…
  description    String?
  isDefault      Boolean  @default(false)   // única plantilla por defecto de la org
  isSystem       Boolean  @default(false)   // precargada — no se puede eliminar
  structure      Json     // PhaseTemplate[] (phaseType, name, order, folders[])
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User         @relation("IndexTemplateCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@map("index_templates")
}

// ─── Plantilla de Papeles de Trabajo por Tipo de Auditoría ───────────────────
// Define qué papeles crear automáticamente al iniciar una auditoría.
// Reemplaza/extiende el mapa AUDIT_TYPE_INDEX hardcodeado.
model AuditTemplate {
  id             String      @id @default(cuid())
  organizationId String
  name           String      @db.VarChar(150)
  description    String?
  auditTypes     Json        // AuditType[] — tipos para los que aparece en el selector
  papers         Json        // PaperDef[] — { code, indexSection, title, type, wpKind, paperCode? }
  isDefault      Boolean     @default(false)  // default para sus tipos aplicables
  isSystem       Boolean     @default(false)  // precargada — solo se puede duplicar
  sections       Json?       // SectionDef[] — folder structure: { ref, name, phaseType, children? }
  links          Json?       // PaperLinkDef[] — { sourceCode, sourceField, targetCode, targetField, mappingType?, description? }
  createdById    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("AuditTemplateCreator", fields: [createdById], references: [id])
  audits         Audit[]

  @@index([organizationId])
  @@map("audit_templates")
}

// ─── Biblioteca de Contenido Reutilizable ────────────────────────────────────
// Unifica dos bibliotecas que antes vivían como archivos TS estáticos:
// procedimientos sustantivos por área (PT-FIN-C-SUST, groupKey = código de
// papel "C-01") y preguntas de evaluación COSO por principio (PT-COSO,
// groupKey = sectionKey "S1"-"S5"). itemSubtitle guarda un dato de una sola
// línea (la Técnica, solo procedimientos); itemDetails guarda un array de
// sub-textos (las preguntas del principio, solo COSO) — cada `kind` usa uno
// de los dos y deja el otro vacío. Mismo patrón organizationId+isSystem que
// AuditTemplate: cada org tiene su propia copia sembrada de la biblioteca de
// sistema, editable; isSystem solo bloquea el borrado, no la edición.
enum ContentLibraryKind {
  SUBSTANTIVE_PROCEDURE
  COSO_QUESTION
}

model ContentLibraryItem {
  id             String             @id @default(cuid())
  organizationId String
  kind           ContentLibraryKind
  groupKey       String             // "C-01" (área) | "S1"-"S5" (componente COSO)
  groupLabel     String?            // etiqueta legible del grupo para la UI de administración
  itemLabel      String             // procedimiento (texto completo) | nombre del principio
  itemSubtitle   String?            // Técnica (Inspección/Confirmación/...) — solo procedimientos
  itemDetails    Json?              // string[] — preguntas del principio — solo COSO
  sortOrder      Int                @default(0)
  isSystem       Boolean            @default(false)
  createdById    String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User         @relation("ContentLibraryItemCreator", fields: [createdById], references: [id])

  @@index([organizationId, kind, groupKey])
  @@map("content_library_items")
}

model AuditTeam {
  id          String   @id @default(cuid())
  auditId     String
  userId      String
  role        String   @default("AUDITOR") // LEAD | AUDITOR | SUPERVISOR | OBSERVER
  assignedAt  DateTime @default(now())

  audit  Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  user   User  @relation(fields: [userId], references: [id])

  @@unique([auditId, userId])
  @@index([auditId])
  @@map("audit_teams")
}

// ─── Documentos de soporte para auditorías imprevistas ───────────────────────
// Adjuntos que respaldan la solicitud (acta del comité, carta de fiscalizador,
// memorando de gerencia, etc.). Mismos tipos de archivo que wpKind=FILE.
model AuditRequestDocument {
  id            String   @id @default(cuid())
  auditId       String
  uploadedById  String
  filename      String   // nombre en Storage (uuid-safe)
  originalName  String   // nombre original del archivo
  mimeType      String   // application/pdf | image/* | application/vnd.openxmlformats...
  fileSize      Int      // bytes
  fileUrl       String   // Supabase Storage public URL
  description   String?  // comentario libre del auditor
  createdAt     DateTime @default(now())

  audit       Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  uploadedBy  User  @relation("UploadedRequestDocs", fields: [uploadedById], references: [id])

  @@index([auditId])
  @@map("audit_request_documents")
}

model AuditProgram {
  id             String   @id @default(cuid())
  auditId        String   @unique
  title          String
  objectives     String?
  steps          Json     @default("[]")
  generatedByAI  Boolean  @default(false)
  approvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([auditId])
  @@map("audit_programs")
}

model WorkingPaper {
  id              String             @id @default(cuid())
  auditId         String
  // ─── Expediente: ubicación en el árbol de carpetas ────────────────────────
  folderId        String?            // null = papel sin carpeta asignada (legacy)
  ref             String?            // "A-01", "B-2.3" — código editable por usuario
  // ─── Identificadores legacy (mantener para compatibilidad) ────────────────
  code            String             // A-1, B-2, C-3, D-1, E-1, AD-1
  indexSection    String             // A | B | C | D | E | AD
  title           String
  type            WorkingPaperType
  // ─── Intelligent Papers ───────────────────────────────────────────────────
  wpKind          WpKind             @default(STANDARD)
  syncStatus      SyncStatus         @default(DRAFT)
  lastSyncedAt    DateTime?
  narrative       String?
  paperCode       String?
  // ─── Encabezado estándar de papel de trabajo ──────────────────────────────
  status          WorkingPaperStatus @default(IN_PROGRESS)
  periodStart     DateTime?          // Inicio del período auditado
  periodEnd       DateTime?          // Fin del período auditado
  notesToReviewer String?            // Canal preparer → revisor
  carryForward    Boolean            @default(false) // Copiar a próximo año
  // ─── Firma adicional (Gerente / CAE) ─────────────────────────────────────
  signedOffById   String?
  signedOffAt     DateTime?
  // ─── F6.2 Sign-off matrix timestamps ─────────────────────────────────────
  preparedAt      DateTime?          // Fecha firma preparador
  reviewedAt      DateTime?          // Fecha firma revisor
  // ─── F6.4 Retención y bloqueo ─────────────────────────────────────────────
  retentionUntil  DateTime?          // Fecha hasta la que debe conservarse
  // ─── Campos existentes ───────────────────────────────────────────────────
  content         Json               @default("{}")
  conclusion      String?
  preparedById    String?
  reviewedById    String?
  qualityScore    Int?               // 0-100
  qualityReport   Json?              // reporte completo del Quality Gate (issues, strengths, recommendation, level)
  qualityCheckedAt DateTime?
  version         Int                @default(1)
  tickMarks       Json               @default("[]")
  crossReferences Json               @default("[]")
  aiAssisted      Boolean            @default(false)
  parentPaperId   String?
  // ─── F6.6 Checkout / collaborative lock ──────────────────────────────────
  checkedOutById  String?            // userId que tiene el paper abierto para edición
  checkedOutAt    DateTime?          // timestamp del checkout (auto-expires 30 min)
  // ─── F6.7 Trial Balance links ─────────────────────────────────────────────
  trialBalanceLinks TrialBalancePaperLink[]
  // ─── Archivo adjunto (wpKind = FILE) ─────────────────────────────────────
  fileUrl          String?           // Supabase Storage public URL
  originalFilename String?           // Nombre original del archivo
  mimeType         String?           // MIME type (application/vnd.openxmlformats...)
  fileSize         Int?              // Tamaño en bytes
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  audit        Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  folder       AuditFolder?   @relation(fields: [folderId], references: [id])
  preparedBy   User?          @relation("PreparedBy",   fields: [preparedById],  references: [id])
  reviewedBy   User?          @relation("ReviewedBy",   fields: [reviewedById],  references: [id])
  signedOffBy  User?          @relation("WpSignedOffBy", fields: [signedOffById], references: [id])
  parent       WorkingPaper?  @relation("PaperHierarchy", fields: [parentPaperId], references: [id])
  children     WorkingPaper[] @relation("PaperHierarchy")
  versions     WorkingPaperVersion[]
  comments     WorkingPaperComment[]
  tickEntries  TickMarkEntry[]
  findings     Finding[]
  // ─── Knowledge graph relations ────────────────────────────────────────────
  sourceLinks   PaperLink[]       @relation("SourcePaper")  // Este papel alimenta a...
  targetLinks   PaperLink[]       @relation("TargetPaper")  // Este papel recibe de...
  sections      PaperSection[]                              // Secciones tipadas (PT Inteligente)
  // ─── @mention references ─────────────────────────────────────────────────
  refsFromHere  PaperReference[]  @relation("RefSource")   // Este papel menciona a...
  refsToHere    PaperReference[]  @relation("RefTarget")   // Este papel es mencionado por...
  // ─── F6.3 PBC links ───────────────────────────────────────────────────────
  pbcLinks      PbcPaperLink[]

  @@index([auditId])
  @@index([auditId, status])
  @@index([auditId, type])
  @@index([auditId, wpKind])
  @@index([auditId, syncStatus])
  @@index([folderId])
  @@map("working_papers")
}

// ─── GRAFO DE CONOCIMIENTO: Arcos entre papeles ───────────────────────────────
model PaperLink {
  id           String      @id @default(cuid())
  sourceId     String      // PT que genera el dato
  targetId     String      // PT que consume el dato
  sourceField  String      // Clave de sección fuente (e.g., "S3.riskLevel")
  targetField  String      // Clave de sección destino (e.g., "S2.inherentRisk")
  mappingType  MappingType @default(DIRECT)
  description  String?     // Descripción human-readable del flujo de datos
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())

  source  WorkingPaper @relation("SourcePaper", fields: [sourceId], references: [id], onDelete: Cascade)
  target  WorkingPaper @relation("TargetPaper", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
  @@map("paper_links")
}

// ─── SECCIONES TIPADAS: Campos estructurados de PT Inteligente ────────────────
model PaperSection {
  id           String    @id @default(cuid())
  paperId      String
  sectionKey   String    // S1, S2, S3... o campo específico
  label        String    // Nombre display de la sección
  description  String?   // Instrucción para el auditor
  fieldType    FieldType @default(TEXT)
  value        Json?     // Valor actual (tipado según fieldType)
  options      Json?     // Para ENUM_SELECT: lista de opciones
  isRequired   Boolean   @default(false)
  isAutoFilled Boolean   @default(false)   // true = llenado por propagación del grafo
  sourceRef    String?   // "paperId::sectionKey" origen si isAutoFilled = true
  sortOrder    Int       @default(0)
  aiHint       String?   // Contexto para el agente IA al generar esta sección
  attachments  Json?     // [{ id, filename, url, mimeType, size, uploadedAt }] — documentos de soporte
  // ─── PI.2 Granular cascade invalidation ──────────────────────────────────
  isStale      Boolean   @default(false)   // true = la fuente cambió, requiere revisión
  staleSince   DateTime?                   // cuándo se marcó stale
  staleReason  String?                     // qué fuente cambió y por qué
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  paper      WorkingPaper     @relation(fields: [paperId], references: [id], onDelete: Cascade)
  procedures AuditProcedure[]

  @@unique([paperId, sectionKey])
  @@index([paperId])
  @@index([paperId, isStale])
  @@map("paper_sections")
}

// ─── @MENTION REFERENCIAS ENTRE PAPELES ──────────────────────────────────────
model PaperReference {
  id               String   @id @default(cuid())
  // Origen — la sección que contiene el @mention
  sourcePaperId    String
  sourceSectionKey String   // sectionKey del campo que contiene el token @[CODE::SKEY]
  // Destino — el papel/sección referenciado
  targetPaperId    String
  targetSectionKey String?  // null = referencia al papel completo (RefType.INDEX)
  // Tipo
  refType          RefType  @default(FIELD)
  // Timestamps
  resolvedAt       DateTime? // última propagación de valor
  createdAt        DateTime  @default(now())

  sourcePaper  WorkingPaper @relation("RefSource", fields: [sourcePaperId], references: [id], onDelete: Cascade)
  targetPaper  WorkingPaper @relation("RefTarget", fields: [targetPaperId], references: [id], onDelete: Cascade)

  @@unique([sourcePaperId, sourceSectionKey, targetPaperId, targetSectionKey])
  @@index([sourcePaperId])
  @@index([targetPaperId])
  @@map("paper_references")
}

// ─── Fiscal SV — Padrón DGII (cache local de contribuyentes) ─────────────────
model DgiiContribuyente {
  id              String   @id @default(cuid())
  organizationId  String   // multi-tenant: cada org carga su padrón
  nit             String   // 14 dígitos (sin guiones)
  nrc             String?  // 6 dígitos (Número Registro de Contribuyente)
  nombre          String
  giro            String?  // actividad económica CIIU
  estado          String   // ACTIVO | SUSPENDIDO | CANCELADO | INSCRITO
  categoria       String?  // PEQUEÑO | MEDIANO | GRANDE | INDIVIDUAL
  fechaInscripcion DateTime?
  fechaCambioEstado DateTime?
  direccion       String?
  importedAt      DateTime @default(now())

  @@unique([organizationId, nit])
  @@index([organizationId, nrc])
  @@index([organizationId, estado])
  @@map("dgii_contribuyentes")
}

model WorkingPaperVersion {
  id        String   @id @default(cuid())
  paperId   String
  version   Int
  content   Json
  changedBy String
  changedAt DateTime @default(now())
  diff      Json?

  // ─── PI.5 — Version history MASTER con diff ──────────────────────────────
  narrative          String?    // Snapshot del narrative del MASTER en ese momento
  sectionsSnapshot   Json?      // Array de secciones: [{ sectionKey, label, value, isAutoFilled }]
  sourcePapersHashes Json?      // { paperCode: SHA-256(sectionsSnapshot) } — para detectar qué fuente cambió
  reason             String?    // "PT-A1 modificó S3" | "Restauración de v2" | etc.
  consolidatedById   String?    // userId que disparó la consolidación
  parentVersionId    String?    // versionNumber de la versión que esta reemplaza
  isRestore          Boolean    @default(false)  // true si esta versión fue creada por restore

  paper  WorkingPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([paperId, version])
  @@map("working_paper_versions")
}

model WorkingPaperComment {
  id          String   @id @default(cuid())
  paperId     String
  authorId    String
  content     String
  resolved    Boolean  @default(false)
  resolvedBy  String?
  createdAt   DateTime @default(now())

  paper  WorkingPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@map("working_paper_comments")
}

model TickMarkEntry {
  id        String   @id @default(cuid())
  paperId   String
  fieldPath String   // ruta del campo en el JSON del papel
  tickMark  TickMark
  note      String?
  createdBy String
  createdAt DateTime @default(now())

  paper  WorkingPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([paperId, tickMark])
  @@map("tick_mark_entries")
}

// ─── MÓDULO 05b: CONFIRMACIONES EXTERNAS (NIA 505) ────────────────────────────

model ExternalConfirmation {
  id                      String             @id @default(cuid())
  auditId                 String
  type                    ConfirmationType
  respondentName          String
  respondentEmail         String
  amount                  Decimal?           @db.Decimal(15, 2)
  accountRef              String?
  sentAt                  DateTime?
  sentBy                  String?
  responseReceivedAt      DateTime?
  responseContent         String?
  responseAmount          Decimal?           @db.Decimal(15, 2)
  difference              Decimal?           @db.Decimal(15, 2)
  differenceExplanation   String?
  status                  ConfirmationStatus @default(DRAFT)
  alternativeProcedure    String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  audit  Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([auditId, status])
  @@map("external_confirmations")
}

// ─── MÓDULO 06: PORTAL DEL AUDITADO ───────────────────────────────────────────

model PbcRequest {
  id               String          @id @default(cuid())
  auditId          String
  organizationId   String
  title            String
  description      String
  requestedToEmail String
  requestedToName  String?
  dueDate          DateTime
  status           PbcRequestStatus @default(PENDING)
  portalToken      String           @unique
  fileUrls         Json             @default("[]")
  rejectionReason  String?
  submittedAt      DateTime?
  acceptedAt       DateTime?
  templateId       String?
  createdById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  audit         Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  organization  Organization @relation(fields: [organizationId], references: [id])
  messages      PbcMessage[]
  paperLinks    PbcPaperLink[]

  @@index([auditId])
  @@index([organizationId])
  @@index([status, dueDate])
  @@map("pbc_requests")
}

// ─── F6.3 PBC ↔ Workpaper links ───────────────────────────────────────────────
model PbcPaperLink {
  id          String   @id @default(cuid())
  pbcId       String
  paperId     String
  // "" (default) = vínculo a nivel de todo el papel, sin cambio de comportamiento.
  // Un valor no vacío escopa el vínculo a una fila MATRIX específica (su "_id"),
  // para poder decir "esta solicitud PBC es la que cierra ESTE hallazgo puntual",
  // no solo el papel completo. Strings vacíos (no null) para que el índice único
  // siga siendo idempotente vía upsert — Postgres trata NULL como siempre distinto.
  sectionKey  String   @default("")
  rowId       String   @default("")
  createdById String
  createdAt   DateTime @default(now())

  pbc         PbcRequest   @relation(fields: [pbcId],   references: [id], onDelete: Cascade)
  paper       WorkingPaper @relation(fields: [paperId],  references: [id], onDelete: Cascade)

  @@unique([pbcId, paperId, sectionKey, rowId])
  @@index([paperId])
  @@index([paperId, sectionKey, rowId])
  @@map("pbc_paper_links")
}

// ─── F6.7 Trial Balance ───────────────────────────────────────────────────────
model TrialBalance {
  id           String   @id @default(cuid())
  auditId      String
  orgId        String
  filename     String
  periodLabel  String   // e.g. "Diciembre 2024"
  accounts     Json     // array: { code, name, debit, credit, balance }
  totalDebit   Decimal  @db.Decimal(18, 2)
  totalCredit  Decimal  @db.Decimal(18, 2)
  isBalanced   Boolean  @default(false)
  importedById String
  importedAt   DateTime @default(now())

  // ─── PI.7b: Benford analysis (NIA 240 forensic) ───────────────────────────
  benfordResult     Json?     // { conformity, risk_score, mad, chi2_*, digits[], top_anomalous_amounts[], interpretation }
  benfordRunAt      DateTime?
  benfordFindingId  String?   // Finding draft auto-generated when risk is high

  audit        Audit                    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  paperLinks   TrialBalancePaperLink[]

  @@index([auditId])
  @@map("trial_balances")
}

model TrialBalancePaperLink {
  id             String @id @default(cuid())
  trialBalanceId String
  paperId        String
  accountCodes   Json   @default("[]")  // selected account codes
  note           String?
  createdAt      DateTime @default(now())
  createdById    String

  trialBalance TrialBalance @relation(fields: [trialBalanceId], references: [id], onDelete: Cascade)
  paper        WorkingPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([trialBalanceId, paperId])
  @@index([paperId])
  @@map("trial_balance_paper_links")
}

model PbcMessage {
  id             String   @id @default(cuid())
  requestId      String
  senderEmail    String
  senderName     String?
  isAuditor      Boolean  @default(false)
  content        String
  attachmentUrls Json     @default("[]")
  createdAt      DateTime @default(now())

  request  PbcRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("pbc_messages")
}

// ─── MÓDULO 07: HALLAZGOS Y RECOMENDACIONES ───────────────────────────────────

model Finding {
  id                   String          @id @default(cuid())
  auditId              String
  workingPaperId       String?
  organizationId       String
  title                String
  condition            String
  criteria             String
  cause                String
  effect               String
  risk                 String
  recommendation       String
  managementResponse   String?
  severity             FindingSeverity
  status               FindingStatus   @default(DRAFT)
  qualityScore         Int             @default(0) // 0-100, mínimo 60 para pasar a revisión
  aiDraftUsed          Boolean         @default(false)
  normativeReference   String?         // Nombre de la norma
  normativeArticle     String?         // Artículo exacto
  isMaterial           Boolean?        // vs materialidad del audit
  effectAmount         Decimal?        @db.Decimal(15, 2)
  responsibleId        String?
  dueDate              DateTime?
  closedAt             DateTime?
  closedById           String?
  isRecurring          Boolean         @default(false)
  previousFindingId    String?
  escalationLevel      EscalationLevel @default(NONE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  audit          Audit          @relation(fields: [auditId], references: [id], onDelete: Cascade)
  workingPaper   WorkingPaper?  @relation(fields: [workingPaperId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  responsible    User?          @relation("FindingResponsible", fields: [responsibleId], references: [id])
  previousFinding Finding?      @relation("FindingRecurrence", fields: [previousFindingId], references: [id])
  relatedFindings Finding[]     @relation("FindingRecurrence")
  actions        FindingAction[]
  comments       FindingComment[]

  @@index([auditId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([dueDate, status])
  @@map("findings")
}

model FindingAction {
  id             String   @id @default(cuid())
  findingId      String
  organizationId String
  description    String
  responsibleId  String?
  dueDate        DateTime
  completionDate DateTime?
  status         String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | OVERDUE
  progressPct    Int      @default(0)
  evidenceUrls   Json     @default("[]")
  comments       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  finding  Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("finding_actions")
}

model FindingComment {
  id         String   @id @default(cuid())
  findingId  String
  authorId   String
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  finding  Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([findingId])
  @@map("finding_comments")
}

// ─── MÓDULO 08: ANALYTICS DE DATOS ────────────────────────────────────────────

model DataAnalysisJob {
  id             String   @id @default(cuid())
  auditId        String
  organizationId String
  type           String   // GL_ANALYSIS | AP_DUPLICATES | PAYROLL | BENFORD | ANOMALY_ML | etc.
  status         String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  parameters     Json     @default("{}")
  resultsSummary Json?
  flaggedCount   Int      @default(0)
  totalRecords   Int      @default(0)
  processingMs   Int?
  createdAt      DateTime @default(now())
  completedAt    DateTime?

  audit        Audit       @relation(fields: [auditId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])
  flags        DataFlag[]

  @@index([auditId])
  @@index([status])
  @@map("data_analysis_jobs")
}

model DataFlag {
  id          String   @id @default(cuid())
  jobId       String
  auditId     String
  entityRef   String   // ID de la transacción o registro analizado
  description String
  riskScore   Float    // 0.0-1.0
  anomalyType String   // DUPLICATE | ROUND_AMOUNT | OUT_OF_HOURS | BENFORD | ML_ANOMALY | etc.
  rawData     Json
  reviewedBy  String?
  reviewedAt  DateTime?
  disposition String?  // ACCEPTED | FALSE_POSITIVE | FINDING_CREATED
  createdAt   DateTime @default(now())

  job  DataAnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([auditId])
  @@index([riskScore])
  @@map("data_flags")
}

// ─── MÓDULO 09: REPORTERÍA ─────────────────────────────────────────────────────

model AuditReport {
  id               String   @id @default(cuid())
  auditId          String
  organizationId   String
  type             String   // EXECUTIVE | DETAILED | FOLLOW_UP | COMMITTEE
  title            String
  content          Json     @default("{}")
  version          Int      @default(1)
  aiGenerated      Boolean  @default(false)
  aiModelUsed      String?
  status           String   @default("DRAFT") // DRAFT | IN_REVIEW | APPROVED | DISTRIBUTED
  approvedById     String?
  approvedAt       DateTime?
  distributionList Json     @default("[]")
  scheduledAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  audit        Audit        @relation(fields: [auditId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

