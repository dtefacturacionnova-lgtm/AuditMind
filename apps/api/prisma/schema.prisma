generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ─────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CAE
  AUDIT_MANAGER
  SENIOR_AUDITOR
  AUDITOR
  AUDITEE
  READ_ONLY
}

enum AuditType {
  INTERNAL
  EXTERNAL
  OPERATIONAL
  FINANCIAL
  IT
  COMPLIANCE
  ESG
  FORENSIC
  BCP_DRP
  // ── Tipos especializados El Salvador ──────────────────────────────────────
  INTERNAL_GOVERNMENTAL // Auditoría Interna Gubernamental (NAIG Decreto 7/2016)
  EXTERNAL_FINANCIAL // Auditoría Externa Financiera (CVPCPA Res. 129/2022 + NIA)
  IT_SECURITY // Seguridad de la Información (ISO 27001:2022 + NRP-23/32)
  BCP_CONTINUITY // Continuidad del Negocio (ISO 22301:2019 + NRP-24)
  IT_SYSTEMS // Sistemas de Información y BD (COBIT 2019 + D.L. 144/2024)
  AML // Prevención Lavado de Dinero y Activos (Ley LCDA + NRP-36 + GAFI)
  FISCAL // Auditoría Fiscal (ISR / IVA / CVPCPA El Salvador)
}

enum AuditStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  CLOSED
  CANCELLED
  DEFERRED // Postergada a período futuro (con justificación)
}

enum AuditEntityType {
  // Tipos jerárquicos de organigrama
  CORPORATE // Corporativo / Holding
  COMPANY // Empresa / Razón Social
  DIVISION // División / Vicepresidencia
  DEPARTMENT // Departamento / Dirección
  AREA // Área / Gerencia
  TEAM // Equipo / Unidad operativa
  BRANCH // Sucursal / Sede / Planta
  SUBSIDIARY // Subsidiaria / Filial
  // Tipos legados (compatibilidad)
  PROCESS
  BUSINESS_UNIT
  LEGAL_ENTITY
  LOCATION
  IT_SYSTEM
  IT_GC
  PROJECT
  VENDOR
  REGULATORY
  STRATEGIC
}

enum AuditOriginType {
  // ─── Planificadas (nacen del flujo Universo Auditable → Plan Anual) ─────────
  PLANNED_RISK_BASED // Planificada — Por Evaluación de Riesgos (mayor RI/RC)
  PLANNED_COMPLIANCE // Planificada — Por Cumplimiento Normativo (mandato legal/regulatorio)
  // ─── Imprevistas (surgen después de aprobado el Plan Anual, siempre con plan asociado) ─
  UNPLANNED_COMMITTEE // Imprevista — Solicitada por Comité de Auditoría
  UNPLANNED_MANAGEMENT // Imprevista — Solicitada por Máxima Autoridad / Dirección
  UNPLANNED_REGULATOR // Imprevista — Solicitada por Fiscalizadores / Ente Regulador
  // ─── Legacy — mantener para compatibilidad con registros existentes ──────────
  PLANNED // → usar PLANNED_RISK_BASED o PLANNED_COMPLIANCE en nuevos registros
  UNPLANNED // → usar UNPLANNED_COMMITTEE / UNPLANNED_MANAGEMENT / UNPLANNED_REGULATOR
  MANAGEMENT_REQUEST // → migrar a UNPLANNED_MANAGEMENT
  REGULATORY_MANDATE // → migrar a UNPLANNED_REGULATOR
  FOLLOW_UP // Seguimiento de hallazgos — siempre debe tener plan asociado
}

enum AuditOpinion {
  SATISFACTORY // Sin observaciones significativas
  NEEDS_IMPROVEMENT // Oportunidades de mejora identificadas
  UNSATISFACTORY // Deficiencias significativas
  CRITICAL // Deficiencias críticas — acción inmediata
  NOT_RATED // Sin calificación (advisory / especial)
}

enum WorkingPaperType {
  PLANNING_UNDERSTANDING // PT-PL → A-x
  CONTROL_EVALUATION // PT-EC → B-x
  SUBSTANTIVE_TEST // PT-PS → C-x
  DATA_ANALYSIS // PT-AD → AD-x
  FINDING // PT-HF → D-x
  CLOSURE_CONCLUSION // PT-CC → E-x
  INTERVIEW // Grabación de entrevista
  CONFIRMATION // Confirmación externa
  NORMATIVE_ANALYSIS // Análisis normativo auto-generado
}

// ─── PAPELES INTELIGENTES: Tipo estructural del papel ─────────────────────────
enum WpKind {
  STANDARD // Adjuntos libres + narrativa — sin propagación
  SMART // Secciones estructuradas tipadas — fuente de datos del grafo
  MASTER // Consolida datos de múltiples PT — generado por IA + revisión humana
  LIVE // Actualizado en tiempo real — no requiere aprobación manual
  FILE // Archivo adjunto (Word, Excel, PPT, PDF, Imagen, Audio) — Supabase Storage
}

// Estado de sincronización del grafo de conocimiento
enum SyncStatus {
  DRAFT // Nunca fue consolidado (estado inicial)
  SYNCED // Datos al día — todas las fuentes actualizadas
  STALE // Alguna fuente cambió — requiere regeneración del auditor
  REGENERATING // Proceso de consolidación IA en curso
}

// Tipos de campo para secciones de PT Inteligente
enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  PERCENTAGE
  BOOLEAN
  ENUM_SELECT
  DATE
  MATRIX // Tabla de riesgos/controles
  REFERENCE // Referencia a otro campo de otro PT
  RISK_REF // Referencia a riesgo del registro
  ATTACHMENT // Archivos adjuntos
  ACCOUNT_SCHEDULE // Cédula analítica multi-nivel: código/nombre/saldo/ajustes/saldo ajustado/notas/evidencia por fila
  DECLARATIONS // Grid editable de declaraciones de independencia con adjunto por fila
  LEGAL_MATRIX // Grid editable de normativas/leyes con columnas especializadas + adjunto por fila
  AUDIT_REPORTS // Grid editable de informes de auditoría interna emitidos con adjunto por fila
  CHECKLIST // Tabla editable Sí/No/N/A por criterio + conclusión global + fundamento
  COMMUNICATION_LOG // Grid de comunicaciones con AI: fecha/participantes/tema/asuntos/adjunto
  PROCEDURE_GRID // Grid jerárquico 2 niveles: Procedimiento → Actividad (NIA 230/330)
  SAMPLE_ITEM_REGISTER // Grid de ítems de muestra con valor en libros/auditado, diferencia y tainting % por fila
  SAMPLING_EVALUATION // Panel computado: extrapolación de errores MUS (MLE/Precisión Básica/UEL) + semáforo, derivado de SAMPLE_ITEM_REGISTER
  FLOWCHART // Editor de flujograma de proceso (nodos/aristas), con nodos vinculables a otro papel/sección
  CAATS_ANALYSIS // Panel de análisis de datos CAATs embebido: motor (GL/AP/Nómina/Benford/Anomalías) + origen de datos + resultado calculado (PT-B4)
}

// Tipo de mapeo entre papeles en el grafo
enum MappingType {
  DIRECT // Copia directa del valor fuente
  AGGREGATED // Agregación de múltiples fuentes
  AI_GENERATED // Genera narrativa con IA usando datos fuente
}

enum WorkingPaperStatus {
  // ─── Valores legacy (compatibilidad hacia atrás) ──────────────────────────
  DRAFT // → migrar a IN_PROGRESS
  IN_REVIEW // → migrar a PENDING_REVIEW
  APPROVED // → migrar a SIGNED_OFF
  ARCHIVED // → migrar a CLOSED
  // ─── Nuevos valores (estándar industria: TeamMate+, CaseWare, AuditBoard) ─
  NOT_STARTED // No Iniciado   — papel creado, sin trabajo aún
  IN_PROGRESS // En Proceso    — auditor trabajando activamente
  PENDING_REVIEW // En Revisión   — enviado al supervisor/revisor
  RETURNED // Observado     — revisor devolvió con comentarios
  REVIEWED // Revisado      — revisor aceptó el trabajo
  SIGNED_OFF // Aprobado      — firma final del gerente/CAE
  CLOSED // Cerrado       — auditoría cerrada, papel bloqueado
}

// ─── Fases del Proyecto de Auditoría ──────────────────────────────────────
enum PhaseType {
  PLANNING // Planificación de la Auditoría
