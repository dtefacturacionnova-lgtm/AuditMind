// ─── MÓDULO 14: COMITÉ DE AUDITORÍA ───────────────────────────────────────────

model CommitteeSession {
  id              String   @id @default(cuid())
  organizationId  String
  sessionDate     DateTime
  agenda          Json     @default("[]")
  minutes         Json?
  attendees       Json     @default("[]")
  status          String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED
  nextSessionDate DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id])
  reports       CommitteeReport[]

  @@index([organizationId])
  @@map("committee_sessions")
}

model CommitteeReport {
  id             String   @id @default(cuid())
  organizationId String
  sessionId      String?
  period         String
  type           String   // QUARTERLY | ANNUAL | SPECIAL
  content        Json
  preparedById   String
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime @default(now())

  organization  Organization      @relation(fields: [organizationId], references: [id])
  session       CommitteeSession? @relation(fields: [sessionId], references: [id])

  @@index([organizationId])
  @@map("committee_reports")
}

// ─── MÓDULO 15: BCP/DRP ───────────────────────────────────────────────────────

model BcpAudit {
  id                 String   @id @default(cuid())
  auditId            String   @unique
  organizationId     String
  framework          String   @default("ISO_22301")
  bcpMaturityScore   Int?     // 1-5
  components         Json     @default("{}")
  rtoRpoAssessment   Json?
  lastTestedAt       DateTime?
  recommendations    Json     @default("[]")
  createdAt          DateTime @default(now())

  audit  Audit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("bcp_audits")
}

// ─── NOTIFICACIONES ───────────────────────────────────────────────────────────

model Notification {
  id             String              @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String
  entityType     String?
  entityId       String?
  read           Boolean             @default(false)
  readAt         DateTime?
  channel        NotificationChannel @default(IN_APP)
  createdAt      DateTime            @default(now())

  organization  Organization @relation(fields: [organizationId], references: [id])
  user          User         @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([organizationId])
  @@map("notifications")
}

// ─── MÓDULO 16: CONECTORES DE DATOS (2.6-2.8) ─────────────────────────────────

model DataSource {
  id              String          @id @default(cuid())
  organizationId  String
  name            String
  type            DataSourceType
  status          ConnectorStatus @default(INACTIVE)
  // Connection config (credenciales almacenadas como JSON — encriptar en prod)
  config          Json            @default("{}")
  // Metadata para test de conectividad
  lastTestedAt    DateTime?
  lastTestStatus  String?         // "ok" | "error"
  lastTestError   String?
  // Estadísticas de importaciones
  lastImportAt    DateTime?
  totalImports    Int             @default(0)
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy     User              @relation(fields: [createdById], references: [id])
  imports       ConnectorImport[]

  @@index([organizationId])
  @@index([organizationId, type])
  @@map("data_sources")
}

model ConnectorImport {
  id           String       @id @default(cuid())
  sourceId     String
  auditId      String?
  status       ImportStatus @default(PENDING)
  // Resultados
  recordCount  Int?
  errorMsg     String?
  result       Json?        // resumen de datos importados
  // Tiempos
  startedAt    DateTime     @default(now())
  completedAt  DateTime?

  source  DataSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  audit   Audit?      @relation(fields: [auditId], references: [id])

  @@index([sourceId])
  @@index([auditId])
  @@map("connector_imports")
}

// ══════════════════════════════════════════════════════════════════════════════
//  PT-PROG: PROGRAMA DE AUDITORÍA — Grid de Procedimientos (NIA 230/330)
//  AuditProcedure (nivel 1) → AuditStep (nivel 2) → StepEvidence (adjuntos)
// ══════════════════════════════════════════════════════════════════════════════

enum ProcStatus {
  PENDING      // Sin comenzar
  IN_PROGRESS  // Al menos un paso iniciado
  COMPLETED    // Todos los pasos aprobados
  NA           // No aplicable
}

enum StepStatus {
  DRAFT        // Borrador — no enviado a revisión
  IN_PROGRESS  // En ejecución
  SUBMITTED    // Enviado a primera revisión
  REVIEWED     // Revisado (puede tener notas)
  CLEARED      // Notas del revisor limpiadas
  APPROVED     // Socio/CAE aprobado
}

enum StepConclusion {
  PENDING      // Sin conclusión aún
  NO_EXCEPTION // Sin excepción — objetivo cumplido
  EXCEPTION    // Con excepción — ver exceptionText/exceptionAmount
  NA           // No aplicable
}

enum TestType {
  DETAIL      // Prueba de detalle (inspección, confirmación, recálculo)
  ANALYTICAL  // Procedimiento analítico sustantivo (NIA 520)
  CONTROL     // Prueba de controles (NIA 330 §8)
}

enum AuditNature {
  INSPECTION      // Inspección de documentos y registros
  OBSERVATION     // Observación de un proceso
  INQUIRY         // Indagación a la gerencia
  CONFIRMATION    // Confirmación externa (NIA 505)
  RECALCULATION   // Recálculo de cómputos
  REPERFORMANCE   // Rejecución de procedimientos del cliente
  ANALYTICAL      // Procedimientos analíticos
}

enum AuditTiming {
  INTERIM     // Interino (antes del cierre)
  YEAR_END    // Al cierre del período
  ROLLFORWARD // Puente interino → cierre
}

// Nivel 1 — Procedimiento de auditoría por área/aserción
model AuditProcedure {
  id             String     @id @default(cuid())
  sectionId      String     // FK → PaperSection (PROCEDURE_GRID)
  refNumber      String     // "B-AR-01", "PROC-01"
  description    String
  assertions     String[]   // ["EXI","VAL","COM","OCC","COM","EXA","COR","CLA","PRE"]
  significantRisk Boolean   @default(false) // ISA 330 §18 — flag binario
  rmmLevel       String?    // "BAJO" | "MODERADO" | "ALTO" | "MUY_ALTO"
  rmmRiskRef     String[]   @default([]) // Refs a filas de riesgo (ej. PT-A2::S5::2) — puede haber varios (ISA 330 §28c)
  wpRef          String?    // Referencia cruzada al papel de trabajo donde se ejecuta/documenta este procedimiento
  conclusionText String?
  status         ProcStatus @default(PENDING)
  sortOrder      Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  section  PaperSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  steps    AuditStep[]

  @@index([sectionId])
  @@index([sectionId, status])
  @@map("audit_procedures")
}

// Nivel 2 — Actividad/Paso dentro de un procedimiento
model AuditStep {
  id                String         @id @default(cuid())
  procedureId       String         // FK → AuditProcedure
  refNumber         String         // "B-AR-01-A"
  description       String
  assertions        String[]       // puede diferir del padre
  testType          TestType       @default(DETAIL)
  nature            AuditNature    @default(INSPECTION)
  timing            AuditTiming    @default(YEAR_END)
  extent            String?        // "45 ítems MUS", "100% de saldo"
  population        String?        // fuente de datos / universo
  performedByName   String?        // ISA 230 §9
  performedById     String?
  datePerformed     DateTime?      // ISA 230 §9 — debe ser ≤ fecha informe
  reviewedByName    String?
  reviewedById      String?
  dateReviewed      DateTime?
  wpRef             String?        // "AR-03-01" — referencia al papel de evidencia
  resultDescription String?        // ISA 330 §28(d)
  conclusion        StepConclusion @default(PENDING)
  exceptionText     String?        // condicional: descripción de la excepción
  exceptionAmount   Decimal?       @db.Decimal(15, 2) // monto observado
  difRef            String?        // referencia a PT-DIFS si hay excepción
  hoursPlanned      Float?
  hoursActual       Float?
  status            StepStatus     @default(DRAFT)
  sortOrder         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  procedure  AuditProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  evidences  StepEvidence[]

  @@index([procedureId])
  @@index([procedureId, status])
  @@map("audit_steps")
}

// Adjuntos por actividad (cédulas B-01, confirmaciones, etc.)
model StepEvidence {
  id             String   @id @default(cuid())
  stepId         String   // FK → AuditStep
  fileName       String
  storageKey     String   // Supabase Storage key
  wpRef          String?  // "AR-03-01"
  mimeType       String
  size           Int      @default(0) // bytes
  uploadedByName String?
  uploadedById   String?
  uploadedAt     DateTime @default(now())

  step  AuditStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("step_evidences")
}
